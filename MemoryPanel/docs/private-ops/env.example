# Server-only placeholders. Configure through the deployment secret manager.
# Never put these in VITE_* or commit actual values.

# Required for the private Markdown board (boardReady).
# HTTPS without embedded credentials is required, except HTTP localhost,
# 127.0.0.1, and [::1] for local development.
PYRITO_PUBLIC_URL=https://<pyrito-host>
PYRITO_OPS_ENCRYPTION_KEY=<64-hex-characters-from-32-random-bytes>
# Persistent storage; defaults to data/private-ops relative to the server cwd.
PYRITO_OPS_DATA_DIR=<absolute-persistent-private-directory>

# Optional Gmail integration. Omit both for a standalone Markdown board.
# Gmail operations require this configuration; mailbox access also requires
# an active verified connection.
COMPOSIO_API_KEY=<composio-project-api-key>
COMPOSIO_GMAIL_AUTH_CONFIG_ID=<enabled-managed-gmail-auth-config-id>

# Optional for manual notes; required for Gmail note generation and enabling
# routines. Reuse the coordinator's OpenAI-compatible model configuration.
WORKBENCH_LLM_API_KEY=<model-provider-api-key>
WORKBENCH_LLM_MODEL=<model-name>
WORKBENCH_LLM_BASE_URL=<https-openai-compatible-api-base>

# For Gmail, also configure the Composio OAuth callback verifier to
# https://<pyrito-host>/api/v1/ops-oauth/callback on a public HTTPS host.
# The provider verifier does not accept the board's localhost development URL.
# A per-connection callback_url alone does not enable identity verification.
